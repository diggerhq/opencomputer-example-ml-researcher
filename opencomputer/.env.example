# Development values belong in OpenComputer secrets/runtime variables. Do not
# commit real values here or place them in prompts.
#
# All variables below are OPTIONAL per-provider. The agent reports a provider
# unavailable when its credentials are not configured instead of failing.
#
# AWS (aws CLI): static credentials or a session. AWS_* names are reserved by
# the platform, so they are set as EXP_AWS_* and exported as AWS_* per command.
EXP_AWS_ACCESS_KEY_ID=
EXP_AWS_SECRET_ACCESS_KEY=
EXP_AWS_SESSION_TOKEN=
EXP_AWS_DEFAULT_REGION=us-east-1
#
# GCP (gcloud CLI): service-account JSON contents and project
GCP_SERVICE_ACCOUNT_JSON=
GCP_PROJECT_ID=
